rules_version = '2';

// Security rules for CodeHero. The guiding principle: clients may READ their
// own data and update only cosmetic/non-economic fields. Everything that
// affects the economy (xp, level, crystals, subscription, league standings)
// is writable ONLY by Cloud Functions (the Admin SDK bypasses these rules),
// so a tampered client cannot inflate its own progress.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Fields the client is allowed to change directly on its user doc.
    function onlyClientFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'photoUrl', 'selectedTrack']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && onlyClientFields();
      allow create, delete: if false; // created by an auth-trigger function

      // Per-track progress: readable by owner, written by functions only.
      match /progress/{trackId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Inventory (crafting): owner may toggle "equipped" only.
      match /inventory/{itemId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['equipped']);
        allow create, delete: if false;
      }

      // Daily quests: read-only to the client; progress written by functions.
      match /quests/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Leagues: any signed-in user may read the board; membership rows and
    // standings are maintained by scheduled/callable functions only.
    match /leagues/{leagueId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
  }
}
