{
  "track": "python",
  "title": "Python Mastery",
  "modules": [
    {
      "id": "py_basics",
      "title": "Getting Started",
      "level": "Junior",
      "lessons": [
        {
          "id": "py_hello",
          "type": "theory",
          "title": "Hello, World",
          "steps": [
            { "kind": "theory", "heading": "print()", "body": "print() displays text in the console. Text (a string) goes inside quotes." },
            { "kind": "theory", "heading": "Example", "body": "This prints a greeting:", "code": "print(\"Hello, World!\")" },
            { "kind": "fill_blank", "prompt": "Print the word Hello.", "template": "print(\"___\")", "answers": ["Hello"], "hint": "Just the word inside the quotes." }
          ]
        },
        {
          "id": "py_variables",
          "type": "fill_blank",
          "title": "Variables",
          "steps": [
            { "kind": "theory", "heading": "Variables", "body": "A variable stores a value. Use = to assign.", "code": "x = 10\nname = \"Ada\"" },
            { "kind": "fill_blank", "prompt": "Store the number 10 in a variable named x.", "template": "___ = 10", "answers": ["x"] },
            { "kind": "fill_blank", "prompt": "Store the text Ada in a variable named name.", "template": "name = \"___\"", "answers": ["Ada"] }
          ]
        },
        {
          "id": "py_first_program",
          "type": "sandbox",
          "title": "Your First Program",
          "steps": [
            { "kind": "theory", "heading": "Math", "body": "Python can do arithmetic with + - * /." },
            { "kind": "sandbox", "instructions": "Print the sum of 2 and 3 (expected output: 5).", "starterCode": "# print the result of 2 + 3\n", "expectedStdout": "5" }
          ]
        }
      ]
    },
    {
      "id": "py_control",
      "title": "Control Flow",
      "level": "Junior",
      "lessons": [
        {
          "id": "py_if",
          "type": "constructor",
          "title": "If Statements",
          "steps": [
            { "kind": "theory", "heading": "if / else", "body": "Run code conditionally. Indentation defines the block.", "code": "if x > 0:\n    print(\"positive\")" },
            { "kind": "constructor", "instructions": "Arrange the blocks to print \"big\" when x is greater than 5.", "blocks": ["x = 10", "if x > 5:", "    print(\"big\")"], "distractors": ["else:"] }
          ]
        },
        {
          "id": "py_loops",
          "type": "sandbox",
          "title": "Loops",
          "steps": [
            { "kind": "theory", "heading": "for loop", "body": "range(n) yields 0..n-1.", "code": "for i in range(3):\n    print(i)" },
            { "kind": "sandbox", "instructions": "Print the numbers 0, 1, 2 each on its own line.", "starterCode": "for i in range(3):\n    # print i\n    pass\n", "expectedStdout": "0\n1\n2" }
          ]
        },
        {
          "id": "py_while",
          "type": "fill_blank",
          "title": "While Loops",
          "steps": [
            { "kind": "theory", "heading": "while", "body": "Repeats while a condition is true.", "code": "i = 0\nwhile i < 3:\n    i += 1" },
            { "kind": "fill_blank", "prompt": "Loop while i is less than 5.", "template": "while i ___ 5:", "answers": ["<"] }
          ]
        },
        {
          "id": "py_boss_control",
          "type": "sandbox",
          "title": "BOSS: FizzBuzz",
          "isBoss": true,
          "timeLimitSeconds": 180,
          "steps": [
            { "kind": "sandbox", "instructions": "For numbers 1..5 print the number, but 'Fizz' for multiples of 3. Expected: 1,2,Fizz,4,5 each on a new line.", "starterCode": "for i in range(1, 6):\n    # your code\n    pass\n", "expectedStdout": "1\n2\nFizz\n4\n5" }
          ]
        }
      ]
    },
    {
      "id": "py_functions",
      "title": "Functions",
      "level": "Junior",
      "lessons": [
        {
          "id": "py_def",
          "type": "theory",
          "title": "Defining Functions",
          "steps": [
            { "kind": "theory", "heading": "def", "body": "Functions group reusable code. They can take parameters and return values.", "code": "def greet(name):\n    return \"Hi \" + name" },
            { "kind": "fill_blank", "prompt": "Complete the keyword that defines a function.", "template": "___ greet(name):", "answers": ["def"] }
          ]
        },
        {
          "id": "py_return",
          "type": "sandbox",
          "title": "Return Values",
          "steps": [
            { "kind": "sandbox", "instructions": "Write a function add(a, b) that returns a + b, then print add(2, 3). Expected: 5.", "starterCode": "def add(a, b):\n    # return the sum\n    pass\n\nprint(add(2, 3))\n", "expectedStdout": "5" }
          ]
        },
        {
          "id": "py_boss_functions",
          "type": "sandbox",
          "title": "BOSS: Max of Two",
          "isBoss": true,
          "timeLimitSeconds": 150,
          "steps": [
            { "kind": "sandbox", "instructions": "Write maximum(a, b) returning the larger value and print maximum(7, 4). Expected: 7.", "starterCode": "def maximum(a, b):\n    # return the larger one\n    pass\n\nprint(maximum(7, 4))\n", "expectedStdout": "7" }
          ]
        }
      ]
    },
    {
      "id": "py_data",
      "title": "Data Structures",
      "level": "Middle",
      "lessons": [
        {
          "id": "py_lists",
          "type": "theory",
          "title": "Lists",
          "steps": [
            { "kind": "theory", "heading": "Lists", "body": "Ordered, mutable collections.", "code": "nums = [1, 2, 3]\nnums.append(4)" },
            { "kind": "fill_blank", "prompt": "Add 4 to the end of the list nums.", "template": "nums.___(4)", "answers": ["append"] }
          ]
        },
        {
          "id": "py_list_sum",
          "type": "sandbox",
          "title": "Summing a List",
          "steps": [
            { "kind": "sandbox", "instructions": "Print the sum of [1, 2, 3, 4]. Expected: 10.", "starterCode": "nums = [1, 2, 3, 4]\n# print the sum\n", "expectedStdout": "10" }
          ]
        },
        {
          "id": "py_dicts",
          "type": "fill_blank",
          "title": "Dictionaries",
          "steps": [
            { "kind": "theory", "heading": "dict", "body": "Key-value pairs.", "code": "ages = {\"Ada\": 36}\nprint(ages[\"Ada\"])" },
            { "kind": "fill_blank", "prompt": "Read the value stored under the key Ada.", "template": "ages[\"___\"]", "answers": ["Ada"] }
          ]
        },
        {
          "id": "py_boss_data",
          "type": "sandbox",
          "title": "BOSS: Count Evens",
          "isBoss": true,
          "timeLimitSeconds": 200,
          "steps": [
            { "kind": "sandbox", "instructions": "Count how many numbers in [1,2,3,4,5,6] are even and print it. Expected: 3.", "starterCode": "nums = [1, 2, 3, 4, 5, 6]\n# print how many are even\n", "expectedStdout": "3" }
          ]
        }
      ]
    },
    {
      "id": "py_oop",
      "title": "Object-Oriented Python",
      "level": "Middle",
      "lessons": [
        {
          "id": "py_class",
          "type": "theory",
          "title": "Classes",
          "steps": [
            { "kind": "theory", "heading": "class", "body": "Classes bundle data and behavior.", "code": "class Dog:\n    def bark(self):\n        return \"Woof\"" },
            { "kind": "constructor", "instructions": "Assemble a class Dog with a bark() method that returns 'Woof'.", "blocks": ["class Dog:", "    def bark(self):", "        return \"Woof\""], "distractors": ["def Dog():"] }
          ]
        },
        {
          "id": "py_oop_sandbox",
          "type": "sandbox",
          "title": "Using a Class",
          "steps": [
            { "kind": "sandbox", "instructions": "Create the Dog class with bark() returning 'Woof', then print Dog().bark(). Expected: Woof.", "starterCode": "class Dog:\n    def bark(self):\n        return \"Woof\"\n\n# print a bark\n", "expectedStdout": "Woof" }
          ]
        }
      ]
    },
    {
      "id": "py_algorithms",
      "title": "Algorithms",
      "level": "Middle+",
      "lessons": [
        {
          "id": "py_factorial",
          "type": "sandbox",
          "title": "Factorial",
          "steps": [
            { "kind": "theory", "heading": "Recursion & loops", "body": "Factorial n! multiplies 1..n." },
            { "kind": "sandbox", "instructions": "Print 5! (factorial of 5). Expected: 120.", "starterCode": "n = 5\nresult = 1\n# compute n! and print result\n", "expectedStdout": "120" }
          ]
        },
        {
          "id": "py_boss_algorithms",
          "type": "sandbox",
          "title": "BOSS: Reverse a String",
          "isBoss": true,
          "timeLimitSeconds": 150,
          "steps": [
            { "kind": "sandbox", "instructions": "Print the reverse of 'hello'. Expected: olleh.", "starterCode": "s = \"hello\"\n# print s reversed\n", "expectedStdout": "olleh" }
          ]
        }
      ]
    },
    {
      "id": "py_strings",
      "title": "Strings & Text",
      "level": "Middle",
      "lessons": [
        {
          "id": "py_fstrings",
          "type": "theory",
          "title": "f-strings",
          "steps": [
            { "kind": "theory", "heading": "Formatted strings", "body": "f-strings embed values inside text.", "code": "name = \"Ada\"\nprint(f\"Hi {name}\")" },
            { "kind": "fill_blank", "prompt": "Complete the prefix that makes a formatted string.", "template": "print(___\"Hi {name}\")", "answers": ["f"] }
          ]
        },
        {
          "id": "py_str_methods",
          "type": "sandbox",
          "title": "String Methods",
          "steps": [
            { "kind": "theory", "heading": "Methods", "body": ".upper(), .lower(), .strip() transform strings." },
            { "kind": "sandbox", "instructions": "Print 'hello' in upper case. Expected: HELLO.", "starterCode": "s = \"hello\"\n# print it uppercased\n", "expectedStdout": "HELLO" }
          ]
        },
        {
          "id": "py_boss_strings",
          "type": "sandbox",
          "title": "BOSS: Count Vowels",
          "isBoss": true,
          "timeLimitSeconds": 200,
          "steps": [
            { "kind": "sandbox", "instructions": "Count the vowels (a,e,i,o,u) in 'education' and print the count. Expected: 5.", "starterCode": "s = \"education\"\n# print the number of vowels\n", "expectedStdout": "5" }
          ]
        }
      ]
    },
    {
      "id": "py_errors",
      "title": "Error Handling",
      "level": "Middle+",
      "lessons": [
        {
          "id": "py_try",
          "type": "theory",
          "title": "try / except",
          "steps": [
            { "kind": "theory", "heading": "Exceptions", "body": "try/except catches errors so the program keeps running.", "code": "try:\n    risky()\nexcept ValueError:\n    print(\"bad value\")" },
            { "kind": "fill_blank", "prompt": "Complete the keyword that catches an exception.", "template": "try:\n    x = 1\n___ Exception:\n    pass", "answers": ["except"] }
          ]
        },
        {
          "id": "py_boss_errors",
          "type": "sandbox",
          "title": "BOSS: Safe Divide",
          "isBoss": true,
          "timeLimitSeconds": 180,
          "steps": [
            { "kind": "sandbox", "instructions": "Try to compute 10 / 0. Catch the exception and print 'error'. Expected: error.", "starterCode": "# divide 10 by 0 safely, print 'error' on failure\n", "expectedStdout": "error" }
          ]
        }
      ]
    }
  ]
}
